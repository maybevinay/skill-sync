# Shared JWT (must match across gateway + services)
JWT_SECRET=change-me-to-a-256-bit-secret-key-for-hs256-skillsync
JWT_ISSUER=skillsync
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# PostgreSQL (also accepted: DB_URL, DB_USERNAME, DB_PASSWORD)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=Amit@8707
DB_USERNAME=root
DB_PASSWORD=Amit@8707

# Auth mail (optional; reset links are also logged)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@skillsync.local

# OpenAI-compatible AI (Capgemini Generative Engine).
# Leave OPENAI_API_KEY empty to use the default in ai-service application.yml.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openai.generative-eu.engine.capgemini.com/v1
OPENAI_MODEL=openai.gpt-5-mini
OPENAI_EMBEDDING_MODEL=amazon.titan-embed-text-v1

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Frontend
VITE_API_BASE_URL=http://localhost:8080
